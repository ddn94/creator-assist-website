# Same variable names in every environment. The values change.
# Copy this file to creator-assist-new/.env.local for local development.
# .env.local is gitignored. Do not commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Comma-separated emails that can open /admin/waitlist (must already have an account).
ADMIN_EMAILS=you@example.com,cofounder@example.com

# Server-only secret key (Project Settings → API). Needed to read the waitlist table.
# Never put this in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Signs the short-lived route cookie (ca_gate). 32+ random characters.
# Without it, the proxy ignores that cookie and reads the profile on every request.
# openssl rand -base64 32
GATE_SECRET=replace_with_a_long_random_string

# Open Exchange Rates app id. Server-only. Used by the daily rate import.
# https://openexchangerates.org/signup
OPEN_EXCHANGE_RATES_APP_ID=your_app_id

# Shared secret for /api/cron/exchange-rates. Vercel Cron sends it as
# Authorization: Bearer <CRON_SECRET>. openssl rand -base64 32
CRON_SECRET=replace_with_a_long_random_string
